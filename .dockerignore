# Keep the build context small and reproducible.
.git
.github
.gitignore
.gitattributes

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Local indexes & data (mounted as a volume at runtime instead)
data/*_index*
data/*_ft*
data/manifest.json
index/
*.ws

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Docs that don't belong in the runtime image
docs/
benchmarks/
*.md
!README.md

# Container files themselves
Dockerfile
docker-compose.yml
.dockerignore
