# WordSwift service configuration
#
# This file is read by systemd as an EnvironmentFile for wordswift.service.
# It is OPTIONAL — the unit provides its own defaults, so removing or emptying
# this file still leaves a working service.
#
# Format notes:
#   * systemd EnvironmentFile syntax is NOT shell. Do not use `export`, do not
#     quote values, and do not use command substitution.
#   * Only WORDSWIFT_DATA_DIR is read by the WordSwift application itself.
#     WORDSWIFT_HOST and WORDSWIFT_PORT are consumed by the unit file, which
#     substitutes them into the ExecStart command line as --host/--port.

# Address to bind. Defaults to loopback only.
#
# WordSwift has NO built-in authentication and enables CORS for all origins.
# Binding to 0.0.0.0 exposes the index — including write endpoints — to anyone
# who can reach the host. Only do that behind a reverse proxy that enforces
# auth, or on a trusted private network. See docs/DOCKER.md for an nginx
# example.
WORDSWIFT_HOST=127.0.0.1

# Listening port.
WORDSWIFT_PORT=7700

# Where indexes are stored. The service unit passes this explicitly as
# --data-dir, so changing it here alone has no effect unless ExecStart is
# updated too. The directory must exist and be writable by the `wordswift`
# user; it is provisioned by the tmpfiles.d snippet shipped with the package.
WORDSWIFT_DATA_DIR=/var/lib/wordswift
